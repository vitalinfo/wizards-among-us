# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# OS / editors
.DS_Store
.idea

# dependencies
/node_modules
/.pnp
.pnp.*

# testing / coverage
/coverage

# next.js
/.next/
/out/

# production
/build

# Cloudflare / OpenNext / wrangler
/.open-next/
/.wrangler/
.dev.vars

# env files — never commit secrets (but keep the example templates)
.env*
!.env.example
!.dev.vars.example

# debug logs
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code
/CLAUDE.local.md
.claude/settings.local.json
.claude/worktrees/
.claude/projects/
