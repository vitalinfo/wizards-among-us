# Copy this file to `.env.local` and fill in real values. NEVER commit secrets.
# Each var is annotated with the phase that first needs it — the Phase 0
# scaffold builds and runs without any of these set.

# --- Database (Phase 1) ---------------------------------------------------
# Plain, portable Postgres. Neon / Supabase-as-Postgres / Heroku PG / RDS all
# work — the app only consumes a standard connection string.
# Local dev: run `pnpm db:up` (see compose.yml) and use (note port 5433):
#   postgresql://wau:wau@localhost:5433/wau
# On Neon: use the POOLED (`-pooler`) string here for the running app.
DATABASE_URL=
# Optional. The DIRECT (non-`-pooler`) string, used only by `pnpm db:migrate`
# (also Heroku's release phase) — Neon recommends direct connections for schema
# changes, and transaction-mode poolers can break migration locks. Falls back to
# DATABASE_URL when unset, which is fine locally.
DIRECT_DATABASE_URL=

# --- Hosting -------------------------------------------------------------
# The single host this app should be served on, no scheme (e.g.
# `staging.wizards-among-us.pp.ua`). In production, requests on any other host
# are redirected here, and http is upgraded to https — see src/middleware.ts.
# Leave unset locally; the middleware is a no-op outside production.
CANONICAL_HOST=

# --- Auth (Phase 3) -------------------------------------------------------
AUTH_SECRET=                 # session/JWT signing secret for the auth library
TELEGRAM_BOT_TOKEN=          # BotFather token (SECRET); used to verify Login Widget hashes
# The bot's @username (without @). Not secret, but read on the SERVER at request
# time and passed to the widget as a prop — deliberately NOT a NEXT_PUBLIC_ var,
# since those are baked into the browser bundle at build time and would survive a
# Heroku pipeline promotion (staging's bot leaking into production).
TELEGRAM_BOT_USERNAME=
ADMIN_ALLOWLIST=             # comma-separated emails allowed to self-provision as admin
# Local-only: set to 1 to enable /dev/login, which bypasses the Telegram widget
# (it can't render on localhost) so you can exercise the parent/volunteer flows.
# NEVER set this in staging/prod — it's a login backdoor, also hard-disabled
# whenever NODE_ENV=production regardless of this flag.
DEV_LOGIN=

# --- Captcha — Cloudflare Turnstile (Phase 4) -----------------------------
# The site key is rendered in the browser but is deliberately NOT a
# NEXT_PUBLIC_ var: those are inlined at build time, and Heroku pipeline
# promotion reuses the compiled slug, so staging's key would leak into
# production. Read server-side and passed to the widget as a prop.
# Local dev can use Cloudflare's official test keys, which work on localhost:
#   site   1x00000000000000000000AA          (always passes)
#          2x00000000000000000000AB          (always fails)
#   secret 1x0000000000000000000000000000000AA  (always passes)
#          2x0000000000000000000000000000000AA  (always fails)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- File storage — Cloudflare R2 / any S3-compatible store (Phase 4) -----
# Uploads hold a child's ВПО certificate and photos, so the bucket must stay
# PRIVATE: nothing is served from a public URL. Reads go through a server route
# that authorizes first and then issues a short-lived signed URL.
# Use a SEPARATE bucket per environment so dev testing can never touch real
# family data.
#
# On R2: endpoint is https://<ACCOUNT_ID>.r2.cloudflarestorage.com and the
# region is literally "auto". Credentials come from an R2 API token with
# Object Read & Write, scoped to this one bucket.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Comma-separated hosts allowed to reach Next's dev resources (HMR, dev overlay)
# when you browse the dev server through something other than localhost — a
# tunnel, an internal DNS name, another machine on your LAN.
# Leave unset if you use http://localhost:3003.
# Without it HMR is blocked, the client chunk graph goes stale, and pages
# server-render but never hydrate — client components are silently inert.
# DEV_ORIGINS=my-tunnel.example.com

# --- Error monitoring — Sentry (Phase 8) ----------------------------------
# Optional. Unset means no error reporting is initialised at all — nothing is
# sent anywhere, and the app behaves exactly as before.
#
# ⚠️ Error contexts in this app can carry data about children: an unhandled
# error inside an application form or a claim may have a child's name, town or
# the family's contact in scope. Sentry sees whatever we send it, so we scrub
# request bodies, cookies and headers before anything leaves the process (see
# sentry.*.config.ts). Do not relax that to "debug something quickly".
#
# The DSN is not a secret in the usual sense — it only permits SENDING events.
#
# ONE Sentry project across environments, distinguished by the `environment`
# tag (set from SENTRY_ENVIRONMENT below). That is what the tag is for: the
# issue stream, alert rules and release health all filter on it, and the same
# bug in staging and production groups into ONE issue — so you see "this
# already happened in staging last week" instead of two unrelated reports.
#
# Deliberately NOT the separate-per-environment rule we use for bots and
# buckets: that rule exists so staging can never touch real family data, and
# Sentry holds errors, not family data. The one real cost of sharing is the
# free tier's event quota, which noisy staging can eat — turn the sample rate
# down there rather than splitting the project.
SENTRY_DSN=
# Which environment events are tagged with (`staging` / `production`).
# Defaults to NODE_ENV when unset, which is right locally and on a plain deploy;
# set it explicitly on Heroku, where staging and production both run as
# "production" and would otherwise be indistinguishable.
SENTRY_ENVIRONMENT=
