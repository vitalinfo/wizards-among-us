#!/usr/bin/env sh
#
# Enable this repo's tracked git hooks by pointing git at the git-hooks/ dir.
# Idempotent. Runs automatically after `pnpm install` (the "prepare" script) and
# can be run by hand: `pnpm hooks:install`.

if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git config core.hooksPath git-hooks
  chmod +x git-hooks/pre-commit 2>/dev/null || true
  echo "git hooks enabled (core.hooksPath=git-hooks)"
else
  echo "not a git work tree; skipping git hooks install"
fi
